# STREAMING_CHUNK:Defining openCypher read-only MATCH/RETURN query syntax
root ::= ws? single-query (ws? ";")? ws?

single-query ::= (match-clause ws?)+ (where-clause ws?)? (with-clause ws?)* return-clause (ws? order-clause)? (ws? limit-clause)?

match-clause ::= "OPTIONAL"? ws? "MATCH" ws pattern
where-clause ::= "WHERE" ws condition
with-clause  ::= "WITH" ws return-items (ws? where-clause)?
return-clause ::= "RETURN" ws ("DISTINCT" ws)? return-items

pattern      ::= pattern-part (ws? "," ws? pattern-part)*
pattern-part ::= node-pattern (ws? rel-pattern ws? node-pattern)*

# STREAMING_CHUNK:Configuring graph nodes and relationships
node-pattern ::= "(" ws? ident? (ws? ":" ws? ident)* (ws? "{" ws? prop-list ws? "}")? ws? ")"

rel-pattern  ::= (rel-right | rel-left | rel-any)
rel-right    ::= "-\[" ws? ident? (ws? ":" ws? ident)? (ws? "*" ws? range)? (ws? "{" ws? prop-list ws? "}")? ws? "\]->"
rel-left     ::= "<-\[" ws? ident? (ws? ":" ws? ident)? (ws? "*" ws? range)? (ws? "{" ws? prop-list ws? "}")? ws? "\]-"
rel-any      ::= "-\[" ws? ident? (ws? ":" ws? ident)? (ws? "*" ws? range)? (ws? "{" ws? prop-list ws? "}")? ws? "\]-"

range        ::= ([0-9]+)? ".." ([0-9]+)? | [0-9]+
prop-list    ::= prop-pair (ws? "," ws? prop-pair)*
prop-pair    ::= ident ws? ":" ws? expr

return-items ::= (return-item (ws? "," ws? return-item)*) | "*"
return-item  ::= expr (ws "AS" ws ident)?

condition    ::= or-expr
or-expr      ::= and-expr (ws "OR" ws and-expr)*
and-expr     ::= not-expr (ws "AND" ws not-expr)*
not-expr     ::= ("NOT" ws)? comp-expr
comp-expr    ::= expr ws? comp-op ws? expr | expr ws "IS" ws ("NOT" ws)? "NULL" | "(" ws? condition ws? ")"

comp-op      ::= "=" | "<>" | "!=" | "<" | "<=" | ">" | ">=" | "CONTAINS" | "STARTS WITH" | "ENDS WITH" | "IN"

expr         ::= atom (ws? ("+" | "-" | "*" | "/") ws? atom)*
atom         ::= func-call | prop-lookup | literal | ident | "(" ws? expr ws? ")"

func-call    ::= ident "(" ws? (expr (ws? "," ws? expr)* | "*")? ws? ")"
prop-lookup  ::= ident "." ident

literal      ::= string | number | "true" | "false" | "null"
string       ::= "\"" [^"\\]* "\"" | "'" [^'\\]* "'"
number       ::= "-"? [0-9]+ ("." [0-9]+)?
ident        ::= [a-zA-Z_][a-zA-Z0-9_]*
ws           ::= [ \t\n\r]+