# STREAMING_CHUNK:Defining IRC client-to-server command syntax
root ::= (message "\r\n")+

message ::= (":" prefix " ")? command (params)?

prefix ::= servername | (nick ("!" user)? ("@" host)?)

command ::= [a-zA-Z]+ | [0-9]{3}

params ::= ( " " middle )* ( " " ":" trailing )?

middle   ::= [^ \r\n\0:][^ \r\n\0]*
trailing ::= [^\r\n\0]*

nick     ::= [a-zA-Z\[\]\\`_^{|}][a-zA-Z0-9\[\]\\`_^{|}-]*
user     ::= [^ \r\n\0@]+
host     ::= [a-zA-Z0-9_.-]+
servername ::= [a-zA-Z0-9_.-]+