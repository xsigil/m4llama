# STREAMING_CHUNK:Defining Pikchr diagram statements
root ::= ws? (statement (ws | ";")*)* ws?

statement ::= (variable-assign | element-stmt | command-stmt)

variable-assign ::= ident ws? "=" ws? expr

element-stmt ::= (label-decl ws)? element-type (ws attribute)* (ws text-string)* (ws attribute)*

label-decl ::= [A-Z][a-zA-Z0-9]* ":"

element-type ::= "box" | "circle" | "ellipse" | "oval" | "cylinder" | "line" | "arrow" | "spline" | "text" | "dot"

# STREAMING_CHUNK:Configuring positioning and style attributes
attribute ::= direction
            | size-attr
            | pos-attr
            | style-attr
            | "same"
            | "fit"

direction ::= "right" | "left" | "up" | "down"

size-attr ::= ("width" | "height" | "rad" | "diameter" | "thickness" | "radius") (ws? ("=" | "is")? ws? expr)?
            | expr "%"?

pos-attr ::= ("at" | "from" | "to" | "then" | "with") ws place
           | "go" ws expr (ws direction)?

place    ::= (ident ".")? compass-pt | ident | "last" ws element-type ("." compass-pt)?
compass-pt ::= "c" | "n" | "s" | "e" | "w" | "ne" | "nw" | "se" | "sw" | "top" | "bottom" | "left" | "right" | "start" | "end"

style-attr ::= "fill" ws color-val
             | "color" ws color-val
             | "thick" | "thin" | "dotted" | "dashed" | "invisible" | "invis"
             | "behind" ws ident
             | "<-" | "->" | "<->"

command-stmt ::= ("assert" | "print") ws expr

text-string ::= "\"" [^"\r\n]* "\"" (ws ("above" | "below" | "ljust" | "rjust" | "aligned" | "big" | "small"))*

expr ::= term (ws? ("+" | "-") ws? term)*
term ::= factor (ws? ("*" | "/") ws? factor)*
factor ::= number ("px" | "in" | "cm" | "%")?
         | ident
         | place
         | "(" ws? expr ws? ")"

color-val ::= ("0x" [0-9a-fA-F]+ | "none" | "white" | "black" | "red" | "green" | "blue" | "gray" | "orange")
number ::= "-"? [0-9]+ ("." [0-9]+)?
ident ::= [a-zA-Z_][a-zA-Z0-9_]*
ws ::= [ \t\n\r]+