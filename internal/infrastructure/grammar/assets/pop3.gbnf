# STREAMING_CHUNK:Defining POP3 client transaction syntax
root ::= auth-phase "\r\n" (transaction-cmd "\r\n")* "QUIT\r\n"

auth-phase ::= user-pass-seq | apop-cmd

user-pass-seq ::= "USER " name "\r\nPASS " password
apop-cmd      ::= "APOP " name " " digest

transaction-cmd ::= stat-cmd
                 | list-cmd
                 | retr-cmd
                 | dele-cmd
                 | noop-cmd
                 | rset-cmd
                 | top-cmd
                 | uidl-cmd

stat-cmd ::= "STAT"
list-cmd ::= "LIST" ( " " [0-9]+ )?
retr-cmd ::= "RETR " [0-9]+
dele-cmd ::= "DELE " [0-9]+
noop-cmd ::= "NOOP"
rset-cmd ::= "RSET"
top-cmd  ::= "TOP " [0-9]+ " " [0-9]+
uidl-cmd ::= "UIDL" ( " " [0-9]+ )?

name     ::= [a-zA-Z0-9_.@-]+
password ::= [^\r\n ]+
digest   ::= [0-9a-fA-F]{32}